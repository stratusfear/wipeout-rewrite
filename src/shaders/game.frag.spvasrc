#version 450

layout(location = 0) in vec2 v_uv;
layout(location = 1) in vec4 v_color;

layout(location = 0) out vec4 out_color;

/* No push constants here: the game pass push block (MVP, view*model rows,
 * screen offset) is consumed by game.vert only. The earlier copy of the
 * vertex-stage block was never referenced and has been removed so the
 * pipeline layout can declare the range for the vertex stage alone. */

layout(set = 0, binding = 0) uniform sampler2D u_texture;

void main() {
    vec4 texColor = texture(u_texture, v_uv);
    out_color = texColor * v_color;
    if (out_color.a <= 0.0) {
        discard;
    }
    out_color.rgb = out_color.rgb * 2.0;
}
