#version 450

layout(location = 0) in vec2 v_uv;

layout(location = 0) out vec4 out_color;

layout(set = 0, binding = 0) uniform sampler2D u_scene;

layout(push_constant) uniform PushConstants {
    vec2 u_resolution;
    float u_time;
} pc;

// POST (none): plain copy, mirrors GL SHADER_POST_FS_DEFAULT.
// The backbuffer is upright (negative-height game viewport: scene top -> row 0),
// and the quad's v_uv.y=1 at the top of the window, so sample with
// (v_uv.x, 1.0 - v_uv.y) to copy it through unchanged: window top -> v=0 ->
// backbuffer row 0 (scene top), window bottom -> v=1 -> backbuffer row H.
//
// The sample coordinate for window row d is (d+0.5)*bbH/H in backbuffer texel
// units. Whenever bbH/H reduces to p/q with p even and q odd, every q-th window
// row (first at d=(q-1)/2 mod q) samples exactly on a texel boundary, and the
// texel a NEAREST fetch picks there is not stable: measured at 480P it flips
// between rows and runs within one stack, differs between the two Vulkan
// stacks (tie rows carried ~230 px/row of divergence beyond the content
// background at 1080 and at 240P-in-1080, both now gone), and differs by
// ratio. Forcing the lower texel reproduces the canonical floor() resampling
// map that GL on llvmpipe produces at 480P@720 (the hand-derived map, and the
// only fully deterministic pick: NVIDIA's GL sampler resolves ties UP at every
// ratio measured and is itself ulp-unstable, so tie rows versus that path stay
// divergent regardless). Shift the lookup by C=0.001 window rows downward:
// that is 0.001*p/q texels, far enough (>=6x) to beat the coordinate's float
// jitter at boundaries, and small enough never to reach the nearest non-tie
// coordinate, which sits at least 1/q texels away (safe for every window size
// while C < 1/p). Verified bit-identical to the old 2/3-only gated bias at
// 720, and bit-identical everywhere no ties exist (e.g. 1/3, and NATIVE).
void main() {
    float bias = -0.001 / pc.u_resolution.y;
    out_color = texture(u_scene, vec2(v_uv.x, 1.0 - v_uv.y + bias));
}
